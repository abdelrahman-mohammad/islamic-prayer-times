// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model for authentication
model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  settings  Settings?
  syncLogs  SyncLog[]

  @@index([googleId])
  @@index([email])
}

// Settings model for user preferences
model Settings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Location
  city                String
  country             String
  latitude            Float
  longitude           Float

  // Prayer Settings
  calculationMethod   Int      @default(1) // 1-5 for different methods
  reminderMinutes     Int[]    @default([30]) // Array for multiple reminders
  selectedPrayers     String[] @default(["Fajr", "Dhuhr", "Asr", "Maghrib", "Isha"])

  // Calendar Settings
  targetCalendarId    String   @default("primary")
  eventTitleTemplate  String   @default("{prayer} Prayer")
  autoSync            Boolean  @default(false)
  syncFrequency       String   @default("daily") // daily, weekly, monthly

  // Auto-Delete Settings
  autoDeleteEvents    Boolean  @default(false)
  deleteEventsAfter   String   @default("end-of-day") // 30min, end-of-day, end-of-week, end-of-month

  // UI Preferences
  theme               String   @default("auto") // light, dark, auto
  language            String   @default("en")

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// SyncLog model for tracking sync operations
model SyncLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  timestamp      DateTime @default(now())
  status         String   // success, failure, cleanup
  eventsCreated  Int      @default(0)
  eventsDeleted  Int      @default(0)
  errorMessage   String?

  @@index([userId])
  @@index([timestamp])
}